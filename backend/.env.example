STRIPE_SECRET_KEY=your_stripe_secret_key
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
ADMIN_EMAIL=admin@quickcommerce.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
